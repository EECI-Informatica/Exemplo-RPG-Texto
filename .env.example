# Porta HTTP local do servidor.
PORT=3000

# Use uma chave aleatória longa e privada. Nunca reutilize este texto de exemplo.
SESSION_SECRET=substitua-por-uma-chave-aleatoria-longa

# Copie os dados exatamente como aparecem no painel do provedor MySQL.
DB_HOST=host-do-provedor
DB_PORT=3306
DB_NAME=nome_do_banco
DB_USER=usuario_do_banco
DB_PASSWORD=substitua-pela-senha-do-banco